---
import Basis from './Basis.astro';

interface Props {
  titel: string;
  beschreibung: string;
  ueberschrift: string;
  einleitung?: string;
}

const { titel, beschreibung, ueberschrift, einleitung } = Astro.props;
---

<Basis titel={titel} beschreibung={beschreibung} brotkrumen={[{ name: ueberschrift, pfad: Astro.url.pathname }]}>
  <section class="huelle py-16 md:py-24">
    <div class="max-w-[46rem]">
      <h1 class="schrift-titel text-stark">{ueberschrift}</h1>
      {einleitung && <p class="schrift-lead mt-6 text-normal">{einleitung}</p>}

      {/* Fließtext für Rechtsseiten. Bewusst schmal gesetzt und ohne
          Gestaltungselemente, damit die Inhalte lesbar bleiben. */}
      <div
        class="mt-12 space-y-6 leading-relaxed text-normal
          [&_a]:font-bold [&_a]:text-stark [&_a]:underline [&_a]:decoration-signal-500 [&_a]:decoration-2 [&_a]:underline-offset-4
          [&_h2]:mt-14 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:tracking-tight [&_h2]:text-stark
          [&_h3]:mt-10 [&_h3]:text-lg [&_h3]:font-bold [&_h3]:text-stark
          [&_li]:mb-2
          [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-6"
      >
        <slot />
      </div>
    </div>
  </section>
</Basis>
