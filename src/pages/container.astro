---
import { Icon } from 'astro-icon/components';
import Basis from '~/layouts/Basis.astro';
import Seitenkopf from '~/components/Seitenkopf.astro';
import Konfigurator from '~/components/Konfigurator.astro';
import Faqliste from '~/components/Faqliste.astro';
import Aktionsband from '~/components/Aktionsband.astro';
import Knopf from '~/components/Knopf.astro';
import Containerbild from '~/components/Containerbild.astro';

import { bild } from '~/lib/bilder';
import { container, bauarten, type Bauart } from '~/lib/daten/container';
import { abfallarten } from '~/lib/daten/abfallarten';
import { fragenFuer } from '~/lib/daten/faq';
import { firma } from '~/lib/firma';

const kopfBild = bild('container', 'hero', 'fuhrpark');
const containerfragen = fragenFuer('container');


const gruppen: { bauart: Bauart; liste: typeof container }[] = [
  { bauart: 'absetz', liste: container.filter((c) => c.bauart === 'absetz') },
  { bauart: 'abroll', liste: container.filter((c) => c.bauart === 'abroll') },
];

const stellplatz = [
  {
    icon: 'ph:ruler-bold',
    titel: 'Fläche messen',
    text: 'Containerlänge plus zwei Meter zum Rangieren. Beim Abrollcontainer kommen etwa zehn Meter Anfahrweg nach hinten dazu.',
  },
  {
    icon: 'ph:tree-bold',
    titel: 'Nach oben schauen',
    text: 'Der Ausleger arbeitet über dem Fahrzeug. Äste, Markisen, Stromleitungen und Balkone müssen frei sein.',
  },
  {
    icon: 'ph:squares-four-bold',
    titel: 'Untergrund prüfen',
    text: 'Pflaster und Platten können unter dem Gewicht nachgeben. Auf empfindlichem Belag legen wir Bohlen unter.',
  },
  {
    icon: 'ph:traffic-cone-bold',
    titel: 'Straße frei halten',
    text: 'Steht der Container öffentlich, braucht es eine Genehmigung und meist ein Halteverbot ein bis zwei Tage vorher.',
  },
];

const schema = [
  {
    '@type': 'Service',
    name: 'Containerdienst',
    serviceType: 'Containervermietung und Abfallentsorgung',
    provider: { '@id': `${Astro.site}#betrieb` },
    areaServed: 'Städteregion Aachen, Kreis Düren',
    description: `Absetz- und Abrollcontainer von 1,8 bis 40 m³ für Bauschutt, Erdaushub, Altholz, Asphalt und gemischte Bau- und Abbruchabfälle.`,
  },
  {
    '@type': 'FAQPage',
    mainEntity: containerfragen.map((f) => ({
      '@type': 'Question',
      name: f.frage,
      acceptedAnswer: { '@type': 'Answer', text: f.antwort },
    })),
  },
];
---

<Basis
  titel="Container mieten von 1,8 bis 40 m³ | Schümmer"
  beschreibung="Absetz- und Abrollcontainer in 15 Größen mit allen Maßen. Für Bauschutt, Erdaushub, Altholz und Baumischabfall in der Städteregion Aachen."
  brotkrumen={[{ name: 'Container', pfad: '/container' }]}
  schema={schema}
>
  <Seitenkopf
    titel="Container in 15 Größen"
    text="Von der 1,8 m³ Mulde für schweren Bauschutt bis zum 40 m³ Abrollcontainer für den Rückbau. Alle Maße stehen hier, damit Sie vorher wissen, ob es auf Ihren Hof passt."
    bild={kopfBild}
    brotkrumen={[{ name: 'Container', pfad: '/container' }]}
  />

  {/* ---------- Bauarten ---------- */}
  <section class="huelle py-20 md:py-28">
    <div class="max-w-[46rem]">
      <h2 class="schrift-titel" data-auf>Absetz oder Abroll, das entscheidet der Platz</h2>
      <p class="schrift-lead mt-5 text-normal" data-auf style="--verzug:1">
        Beide Bauarten fassen ähnliche Mengen. Der Unterschied liegt darin,
        wie das Fahrzeug den Container ablädt und wie viel Raum es dafür braucht.
      </p>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-2">
      {
        (Object.keys(bauarten) as Bauart[]).map((art, i) => {
          const liste = container.filter((c) => c.bauart === art);
          return (
            <div
              class="flex flex-col rounded-[var(--radius-md)] border border-[var(--linie)] bg-[var(--flaeche-erhoben)] p-7 md:p-9"
              data-auf
              style={`--verzug:${i}`}
            >
              <h3 class="schrift-sub text-stark">{bauarten[art].name}</h3>
              <p class="mt-4 leading-relaxed text-normal">{bauarten[art].erklaerung}</p>
              <dl class="mt-7 grid grid-cols-2 gap-6 border-t border-[var(--linie)] pt-6">
                <div>
                  <dt class="text-[0.78rem] font-bold text-[var(--text-leise)]">Volumen</dt>
                  <dd class="zahl mt-1 text-xl font-bold text-stark">
                    {String(Math.min(...liste.map((c) => c.volumen))).replace('.', ',')} bis{' '}
                    {Math.max(...liste.map((c) => c.volumen))} m³
                  </dd>
                </div>
                <div>
                  <dt class="text-[0.78rem] font-bold text-[var(--text-leise)]">Größen im Bestand</dt>
                  <dd class="zahl mt-1 text-xl font-bold text-stark">{liste.length}</dd>
                </div>
              </dl>
            </div>
          );
        })
      }
    </div>
  </section>

  {/* ---------- Größen ---------- */}
  <section class="border-y border-[var(--linie)] bg-[var(--flaeche-gesenkt)] py-20 md:py-28">
    <div class="huelle">
      <div class="max-w-[46rem]">
        <h2 class="schrift-titel" data-auf>Alle Maße auf einen Blick</h2>
        <p class="schrift-lead mt-5 text-normal" data-auf style="--verzug:1">
          Alle Container sind im gleichen Maßstab gezeichnet, daneben steht
          eine Person mit 1,75 m. So sehen Sie sofort, womit Sie es zu tun
          haben, ohne Millimeterangaben umrechnen zu müssen.
        </p>
      </div>

      {
        gruppen.map((gruppe) => (
          <div class="mt-14">
            <h3 class="text-xs font-bold tracking-[0.2em] text-signal-600 uppercase dark:text-signal-400">
              {bauarten[gruppe.bauart].name}
            </h3>

            <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {gruppe.liste.map((c, i) => (
                <article
                  class="rounded-[var(--radius-md)] border border-[var(--linie)] bg-[var(--flaeche-erhoben)] p-6"
                  data-auf
                  style={`--verzug:${i % 3}`}
                >
                  <p class="zahl text-3xl leading-none font-bold text-stark">
                    {String(c.volumen).replace('.', ',')}
                    <span class="ml-1 text-base text-[var(--text-leise)]">m³</span>
                  </p>

                  {/* Alle Karten zeichnen im selben Maßstab, dazu eine Person
                      mit 1,75 m. Damit sieht man auf einen Blick, ob die Mulde
                      in die Einfahrt passt. */}
                  <Containerbild behaelter={c} hervor class="mt-4" />

                  <dl class="zahl mt-5 flex flex-wrap gap-x-5 gap-y-1 text-[0.82rem] text-normal">
                    <div class="flex gap-1.5">
                      <dt class="text-[var(--text-leise)]">L</dt>
                      <dd>{c.tiefe.toLocaleString('de-DE')} mm</dd>
                    </div>
                    <div class="flex gap-1.5">
                      <dt class="text-[var(--text-leise)]">B</dt>
                      <dd>{c.breite.toLocaleString('de-DE')} mm</dd>
                    </div>
                    <div class="flex gap-1.5">
                      <dt class="text-[var(--text-leise)]">H</dt>
                      <dd>{c.hoehe.toLocaleString('de-DE')} mm</dd>
                    </div>
                  </dl>

                  <p class="mt-4 border-t border-[var(--linie)] pt-4 text-[0.85rem] leading-snug text-normal">
                    {c.typisch}
                  </p>

                  {(c.deckel || c.tiefeAusfuehrung) && (
                    <p class="mt-3 text-[0.78rem] text-[var(--text-leise)]">
                      {[
                        c.deckel ? 'wahlweise mit Deckel' : null,
                        c.tiefeAusfuehrung
                          ? `tiefe Ausführung ${c.tiefeAusfuehrung.tiefe.toLocaleString('de-DE')} mm lang`
                          : null,
                      ]
                        .filter(Boolean)
                        .join(', ')}
                    </p>
                  )}
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  {/* ---------- Abfallarten ---------- */}
  <section class="huelle py-20 md:py-28">
    <div class="max-w-[46rem]">
      <h2 class="schrift-titel" data-auf>Was in welchen Container darf</h2>
      <p class="schrift-lead mt-5 text-normal" data-auf style="--verzug:1">
        Wir stellen Container für jegliche Abfälle des europäischen
        Abfallkatalogs. Sortenrein befüllt sind sie günstiger als gemischt: ein
        Sack Gips im Bauschutt macht aus der ganzen Mulde teuren Mischabfall.
      </p>
    </div>

    <div class="mt-12 grid gap-4 lg:grid-cols-2">
      {
        abfallarten.map((a, i) => (
          <article
            class="rounded-[var(--radius-md)] border border-[var(--linie)] bg-[var(--flaeche-erhoben)] p-7"
            data-auf
            style={`--verzug:${i % 2}`}
          >
            <div class="flex items-start gap-4">
              <Icon
                name={a.icon}
                class="mt-1 size-7 shrink-0 text-signal-600 dark:text-signal-400"
                aria-hidden="true"
              />
              <div class="min-w-0">
                <h3 class="schrift-sub text-[1.15rem] text-stark">{a.name}</h3>
                <p class="mt-2 text-[0.95rem] leading-relaxed text-normal">{a.beschreibung}</p>
              </div>
            </div>

            <div class="mt-6 grid gap-6 border-t border-[var(--linie)] pt-6 sm:grid-cols-2">
              <div>
                <p class="text-[0.78rem] font-bold tracking-wide text-[var(--text-leise)] uppercase">
                  Darf hinein
                </p>
                <ul class="mt-3 space-y-1.5 text-[0.88rem] text-normal">
                  {a.gehoertRein.map((eintrag) => (
                    <li class="flex gap-2">
                      <Icon
                        name="ph:check-bold"
                        class="mt-1 size-3.5 shrink-0 text-signal-600 dark:text-signal-400"
                        aria-hidden="true"
                      />
                      {eintrag}
                    </li>
                  ))}
                </ul>
              </div>

              {a.gehoertNichtRein.length > 0 && (
                <div>
                  <p class="text-[0.78rem] font-bold tracking-wide text-[var(--text-leise)] uppercase">
                    Darf nicht hinein
                  </p>
                  <ul class="mt-3 space-y-1.5 text-[0.88rem] text-normal">
                    {a.gehoertNichtRein.map((eintrag) => (
                      <li class="flex gap-2">
                        <Icon name="ph:x-bold" class="mt-1 size-3.5 shrink-0 text-[var(--text-leise)]" aria-hidden="true" />
                        {eintrag}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

            {a.hinweis && (
              <p class="mt-6 border-l-[3px] border-signal-500 bg-[var(--flaeche-gesenkt)] p-4 text-[0.88rem] leading-relaxed text-normal">
                {a.hinweis}
              </p>
            )}
          </article>
        ))
      }
    </div>
  </section>

  {/* ---------- Stellplatz ---------- */}
  <section class="bg-navy-950 py-20 text-navy-200 md:py-28">
    <div class="huelle">
      <div class="max-w-[46rem]">
        <h2 class="schrift-titel text-white" data-auf>Vier Dinge, bevor wir kommen</h2>
        <p class="schrift-lead mt-5 text-navy-300" data-auf style="--verzug:1">
          Die meisten vergeblichen Anfahrten lassen sich mit fünf Minuten
          Vorbereitung vermeiden.
        </p>
      </div>

      <ol class="mt-12 grid gap-px overflow-hidden rounded-[var(--radius-md)] bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
        {
          stellplatz.map((s, i) => (
            <li class="bg-navy-950 p-7" data-auf style={`--verzug:${i}`}>
              <Icon name={s.icon} class="size-7 text-signal-500" aria-hidden="true" />
              <h3 class="mt-5 text-lg font-bold text-white">{s.titel}</h3>
              <p class="mt-2 text-[0.9rem] leading-relaxed text-navy-300">{s.text}</p>
            </li>
          ))
        }
      </ol>

      <p class="mt-10 max-w-[60ch] text-[0.95rem] leading-relaxed text-navy-300" data-auf>
        Unsicher, ob es passt? Schicken Sie uns ein Foto der Zufahrt an{' '}
        <a
          href={`mailto:${firma.email}`}
          class="font-bold text-signal-400 underline decoration-signal-500 underline-offset-4"
        >
          {firma.email}</a>. Wir sagen Ihnen, welche Bauart wir schicken.
      </p>
    </div>
  </section>

  {/* ---------- Konfigurator ---------- */}
  <section class="border-b border-[var(--linie)] bg-[var(--flaeche-gesenkt)] py-20 md:py-28">
    <div class="huelle">
      <Konfigurator />
    </div>
  </section>

  {/* ---------- Fragen ---------- */}
  <section class="huelle py-20 md:py-28">
    <Faqliste fragen={containerfragen} titel="Fragen rund um den Container" />
    <div class="mt-12" data-auf>
      <Knopf href="/entsorgung" variante="linie" iconRechts="ph:arrow-right-bold">
        Was mit dem Abfall passiert
      </Knopf>
    </div>
  </section>

  <Aktionsband
    titel="Container anfragen, Angebot bekommen"
    text="Größe unklar? Kein Problem. Sagen Sie uns, was weg soll, wir schlagen den passenden Container vor."
  />
</Basis>
