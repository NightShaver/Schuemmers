---
import { Icon } from 'astro-icon/components';
import type { Frage } from '~/lib/daten/faq';

interface Props {
  fragen: Frage[];
  titel?: string;
}

const { fragen, titel = 'Was Kunden vor der Bestellung fragen' } = Astro.props;
---

<div class="grid gap-10 lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] lg:gap-16">
  <div>
    <h2 class="schrift-titel" data-auf>{titel}</h2>
    <p class="schrift-lead mt-5 text-normal" data-auf style="--verzug:1">
      Steht Ihre Frage nicht dabei, rufen Sie an. Wir sortieren das in zwei
      Minuten, statt Sie durch ein Formular zu schicken.
    </p>
  </div>

  <div class="divide-y divide-[var(--linie)] border-y border-[var(--linie)]">
    {
      fragen.map((f, i) => (
        <details class="group" data-auf style={`--verzug:${Math.min(i, 4)}`}>
          <summary class="flex cursor-pointer items-start justify-between gap-6 py-5 text-left">
            <span class="schrift-sub text-[1.05rem] leading-snug font-bold text-stark md:text-[1.2rem]">
              {f.frage}
            </span>
            <span class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-[var(--radius-sm)] border border-[var(--linie-stark)] transition-[transform,border-color,background-color] group-open:rotate-45 group-open:border-signal-500 group-open:bg-signal-500">
              <Icon
                name="ph:plus-bold"
                class="size-3.5 text-normal transition-colors group-open:text-navy-950"
                aria-hidden="true"
              />
            </span>
          </summary>
          <p class="max-w-[62ch] pb-6 leading-relaxed text-normal">{f.antwort}</p>
        </details>
      ))
    }
  </div>
</div>
